#!/bin/sh
set -eu

plugin_dir="${HOME}/.config/tmux/plugins"
tpm_dir="$plugin_dir/tpm"

if [ ! -x "$tpm_dir/tpm" ]; then
    mkdir -p "$plugin_dir"
    GIT_TERMINAL_PROMPT=0 git clone --depth 1 https://github.com/tmux-plugins/tpm "$tpm_dir"
fi

# Keep successful reloads quiet and surface installation errors in tmux.
if ! output=$("$tpm_dir/bin/install_plugins" 2>&1); then
    printf '%s\n' "$output" >&2
    exit 1
fi
